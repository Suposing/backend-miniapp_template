{
    "name": "@app/api",
    "version": "0.1.0",
    "description": "通用 NestJS + Prisma + PostgreSQL API",
    "private": true,
    "type": "commonjs",
    "author": "baiwumm",
    "scripts": {
        "dev": "nest start --watch",
        "build": "prisma generate && nest build",
        "start": "node dist/main.js",
        "lint": "eslint .",
        "test": "pnpm build && vitest run",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "db:dev": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@nestjs/common": "11.2.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "11.2.1",
        "@nestjs/jwt": "11.0.2",
        "@nestjs/passport": "11.0.5",
        "@nestjs/platform-express": "11.2.1",
        "@nestjs/schedule": "^12.0.1",
        "@nestjs/swagger": "^11.4.7",
        "@nestjs/throttler": "6.7.1",
        "@scalar/nestjs-api-reference": "1.2.18",
        "bcrypt": "6.0.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "dotenv": "17.4.2",
        "nanoid": "6.0.1",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "pg": "8.23.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "@prisma/client": "7.10.1",
        "@prisma/adapter-pg": "7.10.1",
        "@app/shared": "workspace:*"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.24",
        "@nestjs/schematics": "11.0.8",
        "@nestjs/testing": "11.2.1",
        "@types/bcrypt": "6.0.0",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/node": "22.18.1",
        "@types/passport-jwt": "4.0.1",
        "@types/pg": "8.23.1",
        "express": "^5.2.1",
        "pinyin-pro": "3.29.4",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.8.3",
        "vitest": "4.1.11",
        "prisma": "7.10.1",
        "tsx": "^4.20.0"
    }
}
