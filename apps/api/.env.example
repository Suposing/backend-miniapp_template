# API 服务端配置示例：在仓库根目录执行 node scripts/setup.mjs，自动补齐 apps/api/.env。
# 进程环境变量优先于 .env；修改后重启 API。实际密码和密钥仅保存在本地配置或部署环境中。
# NODE_ENV 由运行环境指定，默认 development，可选 test / production，本示例不固定该变量。

# 日常开发和正常运行使用的 PostgreSQL 业务数据库；API 与 Prisma 迁移、种子脚本共用此连接。
# 必填；格式为 postgresql://用户名:密码@主机:端口/库名，密码中的特殊字符需要进行 URL 编码。
# CHANGE_ME 为占位值，node scripts/setup.mjs 会在新环境中生成与根目录 Compose 配置一致的数据库凭据。
DATABASE_URL=postgresql://app_template:CHANGE_ME@127.0.0.1:15432/app_template

# 自动化测试专用 PostgreSQL 数据库；测试会清理相关表并重建测试数据，与业务数据库隔离。
# 运行测试时必填；建库脚本与测试入口仅允许 localhost/127.0.0.1:15432/app_template_test。
# 不接受其它库名、远程主机、不同端口、查询参数或 URL 片段；密码规则与 DATABASE_URL 相同。
DATABASE_TEST_URL=postgresql://app_template:CHANGE_ME@127.0.0.1:15432/app_template_test

# 后台访问令牌 accessToken 的签名密钥，API 启动时必填；空值会导致配置校验失败。
# node scripts/setup.mjs 会为新环境生成随机值；更换后，使用旧密钥签发的访问令牌将无法通过验证。
JWT_SECRET=

# 后台刷新令牌 refreshToken 的签名密钥；新环境初始化时生成独立随机值。
# 未配置时回退到 JWT_SECRET；更换后，使用旧密钥签发的刷新令牌将无法通过验证。
JWT_REFRESH_SECRET=

# 后台访问令牌的有效期，默认 15 分钟；登录和刷新时签发的新 accessToken 都使用此配置。
# 支持正整数秒数或 s/m/h/d 单位，例如 900、15m、2h；签发前统一换算为秒，不支持 0 或小数。
JWT_EXPIRES_IN=15m

# 登录时勾选“记住我”的刷新会话有效期，默认 30 天，仅影响新建会话。
# 支持正整数秒数或 s/m/h/d 单位；刷新轮换保留原会话到期时间，不从刷新时刻重新计时。
REFRESH_EXPIRES_IN=30d

# 登录时未勾选“记住我”的刷新会话有效期，默认 1 天，仅影响新建会话。
# 支持正整数秒数或 s/m/h/d 单位；刷新轮换保留原会话到期时间。
REFRESH_EXPIRES_IN_SHORT=1d

# 执行 pnpm db:seed 时必填的初始管理员密码，至少 8 位；node scripts/setup.mjs 会为缺失项生成随机值。
# 仅在创建 admin 账号时设置密码；再次运行种子脚本不会重置已有账号密码，API 正常启动不依赖此项。
SEED_ADMIN_PASSWORD=

# API 监听地址，支持 IP 或 localhost；默认 127.0.0.1，仅接受本机连接。
# 局域网真机联调可设置为 0.0.0.0，监听所有 IPv4 网卡，并让客户端使用本机局域网 IP 访问。
HOST=127.0.0.1

# API 监听端口，默认 3000；必须为 1～65535 的十进制整数。
# 修改后同步调整 PUBLIC_API_URL、管理端 VITE_API_BASE_URL 和小程序 APP_BASE_URL。
PORT=3000

# 允许浏览器跨域访问 API 的来源白名单，以英文逗号分隔；默认允许后台 5174 与小程序 H5 5173。
# 每项只填写 HTTP(S) 协议、主机和端口，不填写业务路径、凭据、查询参数或片段，不支持通配符 *。
# localhost 与 127.0.0.1 是不同来源；修改前端主机名或端口后，需要同步更新此项。
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# 客户端可访问的 API 服务公开地址，用于拼接头像等上传资源 URL，也用于生成缺失的前端请求地址。
# 填写 HTTP(S) 服务根地址，可含反向代理部署子路径；不附加 /api/admin、/api/miniapp 或 /uploads。
# 不允许包含凭据、查询参数或片段；未配置时默认 http://localhost:<PORT>，修改监听地址不会自动改写已有值。
PUBLIC_API_URL=http://localhost:3000

# API 信任的反向代理跳数，默认 0，不信任客户端提供的转发头；有效范围为 0～255 的整数。
# 使用反向代理时按实际代理链填写，影响请求来源 IP 的识别，以及按 IP 执行的限流和审计记录。
TRUST_PROXY_HOPS=0

# 后台演示只读模式，默认 false；仅接受 true 或 false。
# 为 true 时拦截后台非白名单写请求，保留读取、预检和显式允许的认证接口；不作用于小程序控制器。
DEMO_MODE=false

# 后台认证接口限流开关，默认 true；仅接受 true 或 false，具体频率由认证控制器的限流规则定义。
# 为 false 时跳过认证限流；自动化 HTTP 测试会显式关闭，避免测试请求触发频率限制。
THROTTLE_ENABLED=true
