generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// 业务字典的可选项，按字典类型保存键值、中文显示名、排序和启停状态。
model dictItems {
  /// 字典项主键。
  id          String    @id @default(cuid())
  /// 所属字典类型编码，关联dict_types.code。
  typeCode    String    @map("type_code")
  /// 字典项业务键值；同一字典类型内唯一。
  value       String
  /// 直接展示的中文名称；同一字典类型内唯一。
  label       String
  /// 字典项显示顺序，数值越小越靠前。
  sort        Int       @default(0)
  /// 是否启用：true启用，false停用。
  enabled     Boolean   @default(true)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 该字典项所属的字典类型。
  typeCodeRef dictTypes @relation("dictItems_typeCode", fields: [typeCode], references: [code], onDelete: Cascade)

  @@unique([typeCode, value])
  @@unique([typeCode, label])
  @@index([typeCode])
  @@map("dict_items")
}

/// 业务字典分类，以唯一编码组织账号状态、日志类型、公告状态等字典项。
model dictTypes {
  /// 字典类型主键。
  id                 String      @id @default(cuid())
  /// 字典类型唯一编码，供字典项关联和接口查询；创建后不可修改。
  code               String
  /// 字典类型的中文名称。
  name               String
  /// 字典类型说明；NULL表示未设置。
  description        String?
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 关联字典项列表。
  dictItems_typeCode dictItems[] @relation("dictItems_typeCode")

  @@unique([code])
  @@map("dict_types")
}

/// 后台操作与访问日志，记录操作人、动作和必要的业务上下文。
model logs {
  /// 日志主键。
  id        String   @id @default(cuid())
  /// 日志类型：operation操作、login登录、api接口、error错误。
  type      String
  /// 操作人内部用户ID，关联users.id；匿名请求或系统任务可为空。
  userId    String?  @map("user_id")
  /// 操作标识，例如user.create、menu.update，用于识别具体业务动作。
  action    String
  /// 请求来源IP；无法获取时为空。
  ip        String?
  /// 客户端User-Agent；未采集时为空。
  userAgent String?  @map("user_agent")
  /// 日志详情JSON；仅记录必要上下文，禁止保存密码、令牌和密钥。
  detail    Json?
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 关联内部用户对象。
  userRef   users?   @relation("logs_userId", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("logs")
}

/// 后台导航和权限资源树，声明页面路由、目录层级及可用操作权限。
model menus {
  /// 菜单主键。
  id               String      @id @default(cuid())
  /// 菜单中文显示名称。
  label            String
  /// 图标名称，保存不带i-lucide-前缀的Lucide图标名。
  icon             String
  /// 页面路由或外部链接；NULL表示无直接跳转目标，非空值全表唯一。
  to               String?
  /// 菜单角标文本；NULL表示未配置。
  badge            String?
  /// 父菜单ID，关联menus.id；NULL表示顶层菜单。
  parentId         String?     @map("parent_id")
  /// 菜单排序值；导航默认降序，管理列表可指定排序方向。
  sort             Int         @default(0)
  /// 是否缓存对应页面组件状态，默认false。
  keepAlive        Boolean     @default(false) @map("keep_alive")
  /// 是否在导航中隐藏；隐藏不等于撤销接口访问权限。
  hideInMenu       Boolean     @default(false) @map("hide_in_menu")
  /// 是否启用该菜单及其权限资源：true启用，false停用。
  enabled          Boolean     @default(true)
  /// 目录菜单是否默认展开，默认false。
  defaultOpen      Boolean     @default(false) @map("default_open")
  /// 菜单声明的操作权限位掩码，按位或组合；各位含义见Permissions枚举，JSON接口以字符串传输。
  permissions      BigInt      @default(0)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 父菜单对象；顶层菜单为空。
  parentRef        menus?      @relation("menus_parentId", fields: [parentId], references: [id], onDelete: Restrict)
  /// 直属子菜单列表。
  menus_parentId   menus[]     @relation("menus_parentId")
  /// 关联角色菜单授权列表。
  roleMenus_menuId roleMenus[] @relation("roleMenus_menuId")

  @@index([parentId])
  @@map("menus")
}

/// 内部公告内容及发布状态，支持指定接收范围、定时发布、撤回、置顶和软删除。
model notices {
  /// 公告主键。
  id                         String              @id @default(cuid())
  /// 公告标题。
  title                      String
  /// 公告富文本HTML内容；渲染前须进行安全过滤。
  content                    String
  /// 发布人内部用户ID，关联users.id；发布人记录被物理删除后可为空。
  publisherId                String?             @map("publisher_id")
  /// 是否置顶：true置顶，false普通展示。
  isTop                      Boolean             @default(false) @map("is_top")
  /// 发布状态：draft待发布、published已发布、withdrawn已撤回；与软删除状态独立。
  status                     String              @default("draft")
  /// 计划发布时间，带时区；到达该时间的待发布公告由发布流程处理。
  publishTime                DateTime            @map("publish_time") @db.Timestamptz(6)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt                  DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 软删除时间，带时区；NULL表示未删除。
  deletedAt                  DateTime?           @map("deleted_at") @db.Timestamptz(6)
  /// 公告发布人账号；账号记录不存在时可为空。
  publisherRef               users?              @relation("notices_publisherId", fields: [publisherId], references: [id], onDelete: SetNull)
  /// 关联公告发布范围列表。
  noticeScopes_noticeId      noticeScopes[]      @relation("noticeScopes_noticeId")
  /// 关联公告阅读记录列表。
  noticeReadRecords_noticeId noticeReadRecords[] @relation("noticeReadRecords_noticeId")
  /// 关联公告催读记录列表。
  noticeRemindLogs_noticeId  noticeRemindLogs[]  @relation("noticeRemindLogs_noticeId")

  @@index([publisherId])
  @@map("notices")
}

/// 公告接收范围配置，支持按组织、岗位或指定人员选择接收对象。
model noticeScopes {
  /// 发布范围记录主键。
  id        String   @id @default(cuid())
  /// 公告ID，关联notices.id。
  noticeId  String   @map("notice_id")
  /// 范围类型：dept组织、post岗位、user指定人员。
  scopeType String   @map("scope_type")
  /// 目标记录ID，按scope_type对应depts、posts或users；该多类型关联由业务层校验，无直接外键。
  targetId  String   @map("target_id")
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 关联公告对象。
  noticeRef notices  @relation("noticeScopes_noticeId", fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@map("notice_scopes")
}

/// 用户对公告的阅读记录；同一公告与用户的组合唯一。
model noticeReadRecords {
  /// 阅读记录主键。
  id        String   @id @default(cuid())
  /// 公告ID，关联notices.id。
  noticeId  String   @map("notice_id")
  /// 阅读者内部用户ID，关联users.id。
  userId    String   @map("user_id")
  /// 公告阅读时间，带时区。
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)
  /// 阅读请求来源IP；未采集时为空字符串。
  ipAddress String   @default("") @map("ip_address")
  /// 关联公告对象。
  noticeRef notices  @relation("noticeReadRecords_noticeId", fields: [noticeId], references: [id], onDelete: Cascade)
  /// 关联内部用户对象。
  userRef   users    @relation("noticeReadRecords_userId", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([noticeId])
  @@index([userId])
  @@map("notice_read_records")
}

/// 公告催读操作记录，保存操作者和时间，供重复催读频率控制使用。
model noticeRemindLogs {
  /// 催读记录主键。
  id            String   @id @default(cuid())
  /// 被催读的公告ID，关联notices.id。
  noticeId      String   @map("notice_id")
  /// 发起催读的内部用户ID，关联users.id。
  remindedBy    String   @map("reminded_by")
  /// 催读操作时间，带时区；用于当前24小时重复催读限制。
  remindedAt    DateTime @default(now()) @map("reminded_at") @db.Timestamptz(6)
  /// 关联公告对象。
  noticeRef     notices  @relation("noticeRemindLogs_noticeId", fields: [noticeId], references: [id], onDelete: Cascade)
  /// 发起催读的内部用户账号。
  remindedByRef users    @relation("noticeRemindLogs_remindedBy", fields: [remindedBy], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([remindedBy])
  @@map("notice_remind_logs")
}

/// 发送给具体内部用户的站内通知，记录展示文案、跳转目标和已读状态。
model notifications {
  /// 站内通知主键。
  id           String    @id @default(cuid())
  /// 接收者内部用户ID，关联users.id。
  recipientId  String    @map("recipient_id")
  /// 通知类型；当前使用system系统通知、notice_publish公告发布、notice_remind公告催读。
  type         String    @default("system")
  /// 通知标题。
  title        String
  /// 通知摘要或正文；NULL表示无补充内容。
  content      String?
  /// 通知关联的页面路径或跳转目标；NULL表示无跳转目标。
  link         String?
  /// 已读时间，带时区；NULL表示未读。
  readAt       DateTime? @map("read_at") @db.Timestamptz(6)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 通知接收者账号。
  recipientRef users     @relation("notifications_recipientId", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@map("notifications")
}

/// 组织与部门树，维护上下级关系、负责人和启停状态，支持软删除。
model depts {
  /// 组织主键。
  id             String    @id @default(cuid())
  /// 父组织ID，关联depts.id；NULL表示顶层组织。
  parentId       String?   @map("parent_id")
  /// 组织名称；未软删除的组织之间名称唯一。
  name           String
  /// 组织编码；NULL表示未设置，未软删除的组织之间编码唯一。
  code           String?
  /// 负责人内部用户ID，关联users.id；NULL表示未指定负责人。
  leaderId       String?   @map("leader_id")
  /// 组织排序值；组织树默认按值降序展示。
  sort           Int       @default(0)
  /// 组织状态：enabled启用，disabled停用。
  status         String    @default("enabled")
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 软删除时间，带时区；NULL表示未删除。
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// 父组织对象；顶层组织为空。
  parentRef      depts?    @relation("depts_parentId", fields: [parentId], references: [id], onDelete: Restrict)
  /// 组织负责人账号；未指定时为空。
  leaderRef      users?    @relation("depts_leaderId", fields: [leaderId], references: [id], onDelete: SetNull)
  /// 直属下级组织列表。
  depts_parentId depts[]   @relation("depts_parentId")
  /// 关联岗位列表。
  posts_deptId   posts[]   @relation("posts_deptId")
  /// 关联内部用户列表。
  users_deptId   users[]   @relation("users_deptId")

  @@index([parentId])
  @@index([leaderId])
  @@map("depts")
}

/// 组织下的岗位档案，维护岗位类别、职级及启停状态，支持软删除。
model posts {
  /// 岗位主键。
  id               String      @id @default(cuid())
  /// 所属组织ID，关联depts.id。
  deptId           String      @map("dept_id")
  /// 岗位名称；同一组织中未软删除岗位的名称唯一。
  name             String
  /// 岗位类别：management管理、professional专业、production生产。
  category         String      @default("management")
  /// 岗位职级，例如P1-P10或M1-M5；空字符串表示未设置。
  rank             String      @default("")
  /// 岗位状态：enabled启用，disabled停用。
  status           String      @default("enabled")
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 软删除时间，带时区；NULL表示未删除。
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)
  /// 关联组织部门对象。
  deptRef          depts       @relation("posts_deptId", fields: [deptId], references: [id], onDelete: Restrict)
  /// 关联用户岗位关联列表。
  userPosts_postId userPosts[] @relation("userPosts_postId")

  @@index([deptId])
  @@map("posts")
}

/// 内部用户与岗位的多对多关联；用户与岗位组合唯一，并可标记一条主岗记录。
model userPosts {
  /// 用户岗位关联记录主键。
  id        String   @id @default(cuid())
  /// 内部用户ID，关联users.id。
  userId    String   @map("user_id")
  /// 岗位ID，关联posts.id。
  postId    String   @map("post_id")
  /// 是否主岗；同一用户最多一条true记录，未指定主岗时可全部为false。
  isMain    Boolean  @default(false) @map("is_main")
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 关联内部用户对象。
  userRef   users    @relation("userPosts_userId", fields: [userId], references: [id], onDelete: Cascade)
  /// 关联岗位对象。
  postRef   posts    @relation("userPosts_postId", fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("user_posts")
}

/// 内部账号的刷新会话，仅保存令牌摘要与有效期，用于刷新轮换和会话撤销。
model refreshTokens {
  /// 刷新会话记录主键。
  id        String   @id @default(cuid())
  /// 会话所属内部用户ID，关联users.id。
  userId    String   @map("user_id")
  /// 刷新令牌的SHA-256摘要，唯一；不保存原始刷新令牌。
  tokenHash String   @map("token_hash")
  /// 刷新会话到期时间，带时区；过期记录不能用于刷新登录。
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 关联内部用户对象。
  userRef   users    @relation("refreshTokens_userId", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

/// 后台权限角色定义，通过菜单授权与用户角色关联分配权限。
model roles {
  /// 角色主键。
  id               String      @id @default(cuid())
  /// 角色显示名称，全表唯一。
  name             String
  /// 角色唯一编码；super_admin表示系统超级管理员角色。
  code             String
  /// 角色用途说明；NULL表示未设置。
  description      String?
  /// 是否启用角色；停用角色不参与当前用户的有效授权计算。
  enabled          Boolean     @default(true)
  /// 角色排序值。
  sort             Int         @default(0)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt        DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 关联角色菜单授权列表。
  roleMenus_roleId roleMenus[] @relation("roleMenus_roleId")
  /// 关联用户角色关联列表。
  userRoles_roleId userRoles[] @relation("userRoles_roleId")

  @@unique([name])
  @@unique([code])
  @@map("roles")
}

/// 角色与菜单的授权关联，保存该角色在指定菜单上的操作权限；角色与菜单组合为主键。
model roleMenus {
  /// 角色ID，关联roles.id。
  roleId      String   @map("role_id")
  /// 菜单ID，关联menus.id。
  menuId      String   @map("menu_id")
  /// 该角色在此菜单上的授权位掩码，按位或组合；0表示无操作权限，JSON接口以字符串传输。
  permissions BigInt   @default(0)
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 关联角色对象。
  roleRef     roles    @relation("roleMenus_roleId", fields: [roleId], references: [id], onDelete: Cascade)
  /// 关联菜单对象。
  menuRef     menus    @relation("roleMenus_menuId", fields: [menuId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@index([roleId])
  @@index([menuId])
  @@map("role_menus")
}

/// 系统配置项，使用唯一配置键保存JSON值，并按配置分组归类。
model settings {
  /// 配置项主键。
  id          String  @id @default(cuid())
  /// 配置项唯一键。
  key         String
  /// 配置值JSON，具体结构由该配置项的业务约定决定。
  value       Json
  /// 配置项所属分组。
  group       String
  /// 配置项用途说明；NULL表示未设置。
  description String?

  @@unique([key])
  @@map("settings")
}

/// 后台内部账号及员工档案，维护登录身份、账号状态、联系方式和组织归属。
model users {
  /// 内部用户主键。
  id                          String              @id @default(cuid())
  /// 登录用户名；未软删除的账号之间唯一。
  username                    String
  /// 用户邮箱；未软删除的账号之间唯一。
  email                       String
  /// bcrypt密码哈希；不保存明文密码。
  passwordHash                String              @map("password_hash")
  /// 后台界面展示的用户姓名或昵称。
  displayName                 String              @map("display_name")
  /// 头像地址或访问路径；NULL表示未设置。
  avatar                      String?
  /// 联系电话；NULL表示未设置。
  phone                       String?
  /// 用户标签列表，默认空数组。
  tags                        String[]            @default([])
  /// 最近一次成功登录时间，带时区；从未登录时为空。
  lastLoginAt                 DateTime?           @map("last_login_at") @db.Timestamptz(6)
  /// 个人网站地址；NULL表示未设置。
  website                     String?
  /// GitHub用户名；NULL表示未设置。
  githubUsername              String?             @map("github_username")
  /// X账号用户名；NULL表示未设置。
  xUsername                   String?             @map("x_username")
  /// 所属组织ID，关联depts.id；NULL表示尚未分配组织。
  deptId                      String?             @map("dept_id")
  /// 员工工号；NULL表示未设置。
  employeeNo                  String?             @map("employee_no")
  /// 在职状态：employed在职、resigned离职；NULL表示未设置，与账号启停状态独立。
  employmentStatus            String?             @map("employment_status")
  /// 入职日期，仅包含年月日。
  entryDate                   DateTime?           @map("entry_date") @db.Date
  /// 性别：male男、female女；NULL表示未设置。
  gender                      String?
  /// 账号状态：active正常、disabled停用；控制账号是否可用，与在职状态独立。
  status                      String              @default("active")
  /// 会话版本号；改密、停用等操作递增，用于使旧令牌失效。
  tokenVersion                Int                 @default(0) @map("token_version")
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt                   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 记录最后更新时间，带时区；Prisma写入时自动维护，直接SQL更新需自行维护。
  updatedAt                   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 软删除时间，带时区；NULL表示未删除。
  deletedAt                   DateTime?           @map("deleted_at") @db.Timestamptz(6)
  /// 用户所属组织；未分配时为空。
  deptRef                     depts?              @relation("users_deptId", fields: [deptId], references: [id], onDelete: SetNull)
  /// 关联系统日志列表。
  logs_userId                 logs[]              @relation("logs_userId")
  /// 该用户作为发布人的公告列表。
  notices_publisherId         notices[]           @relation("notices_publisherId")
  /// 关联公告阅读记录列表。
  noticeReadRecords_userId    noticeReadRecords[] @relation("noticeReadRecords_userId")
  /// 该用户发起的公告催读记录。
  noticeRemindLogs_remindedBy noticeRemindLogs[]  @relation("noticeRemindLogs_remindedBy")
  /// 关联站内通知列表。
  notifications_recipientId   notifications[]     @relation("notifications_recipientId")
  /// 该用户担任负责人的组织列表。
  depts_leaderId              depts[]             @relation("depts_leaderId")
  /// 关联用户岗位关联列表。
  userPosts_userId            userPosts[]         @relation("userPosts_userId")
  /// 关联刷新令牌会话列表。
  refreshTokens_userId        refreshTokens[]     @relation("refreshTokens_userId")
  /// 关联用户角色关联列表。
  userRoles_userId            userRoles[]         @relation("userRoles_userId")

  @@index([deptId])
  @@map("users")
}

/// 内部用户与角色的多对多关联；用户与角色组合为主键，防止重复绑定。
model userRoles {
  /// 内部用户ID，关联users.id。
  userId    String   @map("user_id")
  /// 角色ID，关联roles.id。
  roleId    String   @map("role_id")
  /// 记录创建时间，带时区，默认使用数据库当前时间。
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 关联内部用户对象。
  userRef   users    @relation("userRoles_userId", fields: [userId], references: [id], onDelete: Cascade)
  /// 关联角色对象。
  roleRef   roles    @relation("userRoles_roleId", fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}
